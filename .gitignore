# OS
.DS_Store

# Node
node_modules/

# Real env files — only *.env.example templates are tracked
.env
*.env
!*.env.example

# NOTE: edgeworker-bundle/bundle.tgz IS tracked on purpose — this repo exists to
# carry the built EdgeWorker bundle so it can be uploaded to the new EW.

# Pitch material — decks stay out of the code repo. Generated PowerPoint is
# build output; the HTML decks and the .pptx generator carry client-specific
# copy and figures filled in per meeting. All still live on disk, just untracked.
*.pptx
demo/spike/customer-deck.html
demo/spike/architecture-slides.html
# The .pptx generators, one per deck. Comment on its own line: a trailing '#'
# is literal in .gitignore, so it would silently break the pattern.
demo/spike/build-*.py

# Personal working notes, surfaced in the ~/Projects daily-brief sweep. Same
# file exists across sibling projects; it is a scratchpad, not project docs.
NEXT.md
