# Demo UI (demo/server.js) — copy to demo/.env, or export before `npm start`.
PORT=8080
PRODUCTION_HOST=<new-property-host>                 # the new Akamai property hostname
WASM_URL=https://977adc68-2ede-4bf3-9b1e-41923fa6d7a9.fwf.app   # reused write-through converter
AKAMAI_STAGING=1                                    # resolve <host>.edgekey-staging.net per request
HARPER_PREVIEW_URL=https://<new-node-fqdn>          # Render Lab: /render_preview, /cache_clear
HARPER_BOT_KEY=<same-as-BOT_REQUEST_KEY>            # x-pr-req-key the Render Lab sends
