# Renderer service (cloud VM) — copy to renderer/.env on the VM.
# The renderer connects OUTBOUND to Harper's HTTP+MQTT port; the VM must reach it.
HDB_HOST=<new-node-fqdn>          # e.g. gq4-<name>.harperfabric.com  (NO scheme)
HDB_HTTP_PORT=9926                # Harper HTTP API (undici pool AND MQTT-over-WS ride this)
HDB_MQTT_PORT=1883                # validated but not used to open the socket
HDB_USER=<harper-user>            # Basic auth + MQTT username
HDB_PASS=<harper-pass>            # Basic auth + MQTT password
WORKER_ID=cloud-1                 # unique per renderer instance
NODE_ENV=production               # production => HTTPS/WSS to Harper
# CONCURRENCY=                    # optional; default = max(cores-5, 2)
